{"source":"shadcn","slug":"input-group-icon","kind":"pattern","name":"input-group-icon","one_line":null,"page":"https://ui.shadcn.com/docs/components/input-group-icon","install":"npx shadcn@latest add input-group-icon","licence":"MIT","licence_url":"https://github.com/shadcn-ui/ui/blob/main/LICENSE.md","withheld":false,"files":[{"path":"registry/new-york-v4/examples/input-group-icon.tsx","content":"import {\n  CheckIcon,\n  CreditCardIcon,\n  InfoIcon,\n  MailIcon,\n  SearchIcon,\n  StarIcon,\n} from \"lucide-react\"\n\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@/registry/new-york-v4/ui/input-group\"\n\nexport default function InputGroupIcon() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-6\">\n      <InputGroup>\n        <InputGroupInput placeholder=\"Search...\" />\n        <InputGroupAddon>\n          <SearchIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput type=\"email\" placeholder=\"Enter your email\" />\n        <InputGroupAddon>\n          <MailIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon>\n          <CreditCardIcon />\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">\n          <CheckIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon align=\"inline-end\">\n          <StarIcon />\n          <InfoIcon />\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  )\n}\n","sha256":"80e8f6a2298e726ad36975aa7c1720ce5c245a7247499155571b6c6f055bebd0","bytes":1180}],"facts":[{"key":"file_count","value":"1","unit":"files","selector":"registry-item.files"},{"key":"source_bytes","value":"1180","unit":"bytes","selector":"registry-item.files"}]}