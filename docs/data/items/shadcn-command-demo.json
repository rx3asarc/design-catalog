st>\n    </Command>\n  )\n}\n","sha256":"da6068f90f9d8fd428acac6235b84b23287b7a4a9d563cc4516dcd264590e19b","bytes":1558}],"facts":[{"key":"file_count","value":"1","unit":"files","selector":"registry-item.files"},{"key":"source_bytes","value":"1558","unit":"bytes","selector":"registry-item.files"}]}