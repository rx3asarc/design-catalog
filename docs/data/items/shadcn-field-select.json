{"source":"shadcn","slug":"field-select","kind":"pattern","name":"field-select","one_line":null,"page":"https://ui.shadcn.com/docs/components/field-select","install":"npx shadcn@latest add field-select","licence":"MIT","licence_url":"https://github.com/shadcn-ui/ui/blob/main/LICENSE.md","withheld":false,"files":[{"path":"registry/new-york-v4/examples/field-select.tsx","content":"import {\n  Field,\n  FieldDescription,\n  FieldLabel,\n} from \"@/registry/new-york-v4/ui/field\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/registry/new-york-v4/ui/select\"\n\nexport default function FieldSelect() {\n  return (\n    <div className=\"w-full max-w-md\">\n      <Field>\n        <FieldLabel>Department</FieldLabel>\n        <Select>\n          <SelectTrigger>\n            <SelectValue placeholder=\"Choose department\" />\n          </SelectTrigger>\n          <SelectContent>\n            <SelectItem value=\"engineering\">Engineering</SelectItem>\n            <SelectItem value=\"design\">Design</SelectItem>\n            <SelectItem value=\"marketing\">Marketing</SelectItem>\n            <SelectItem value=\"sales\">Sales</SelectItem>\n            <SelectItem value=\"support\">Customer Support</SelectItem>\n            <SelectItem value=\"hr\">Human Resources</SelectItem>\n            <SelectItem value=\"finance\">Finance</SelectItem>\n            <SelectItem value=\"operations\">Operations</SelectItem>\n          </SelectContent>\n        </Select>\n        <FieldDescription>\n          Select your department or area of work.\n        </FieldDescription>\n      </Field>\n    </div>\n  )\n}\n","sha256":"65d4eeac0ba1ae8a469a2d06b23d059ddca00ad1dcedc64e4354c570dcc7a0a8","bytes":1215}],"facts":[{"key":"file_count","value":"1","unit":"files","selector":"registry-item.files"},{"key":"source_bytes","value":"1215","unit":"bytes","selector":"registry-item.files"}]}